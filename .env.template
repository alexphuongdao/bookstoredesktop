# Copy this to .env and fill in YOUR values
# This is the ONLY file you need to edit to get the project running

# MySQL Database (update with your MySQL credentials)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/bookstore

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your_secret_key_here_change_this_to_random_string

# Manager account credentials (auto-created on first run)
ADMIN_USERNAME=manager
ADMIN_PASSWORD=manager123

# Email config (optional - leave blank to skip email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=bookstore@example.com
